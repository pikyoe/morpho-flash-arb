# =============================================================================
# morpho-flash-arb — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp env.example .env
#
# NEVER commit .env to git (it's already in .gitignore).
#
# KEY ARCHITECTURE (2-key minimum for production):
#   ADMIN KEY (cold wallet) — hardware wallet or multisig
#     - Holds: DEFAULT_ADMIN_ROLE + ADMIN_ROLE
#     - Use for: deploy, whitelist, set limits, withdraw, pause, revoke roles
#     - NEVER use for bot transactions
#
#   OPERATOR KEY (hot wallet) — on the bot server
#     - Holds: OPERATOR_ROLE only
#     - Use for: executeArbitrage only
#     - If compromised: admin revokes role, bot dies, funds safe
#
#   PAUSER KEY (separate hot wallet) — emergency response
#     - Holds: PAUSER_ROLE only
#     - Use for: pause only
# =============================================================================

# -----------------------------------------------------------------------------
# Foundry Scripts — Deploy.s.sol (uses ADMIN key)
# -----------------------------------------------------------------------------
# Deployer PRIVATE_KEY (the ADMIN cold wallet — NOT the bot wallet)
PRIVATE_KEY=0x_YOUR_ADMIN_PRIVATE_KEY_HERE

# Flash loan size limits per asset.
# Format: raw token units (NOT human-readable).
# If not set, asset uses DEFAULT_MIN_FLASH_LOAN_SIZE = 1e6.
# Set to 0 or leave unset to skip (no max limit if unset).

# USDC (6 decimals)
# MIN: 1000000000 = 1,000 USDC | MAX: 10000000000 = 10,000 USDC
MIN_FLASH_LOAN_USDC=1000000000
MAX_FLASH_LOAN_USDC=10000000000

# WETH (18 decimals)
# MIN: 100000000000000000 = 0.1 WETH | MAX: 1000000000000000000 = 1.0 WETH
MIN_FLASH_LOAN_WETH=100000000000000000
MAX_FLASH_LOAN_WETH=1000000000000000000

# CBETH (18 decimals)
MIN_FLASH_LOAN_CBETH=100000000000000000
MAX_FLASH_LOAN_CBETH=1000000000000000000

# WSTETH (18 decimals)
MIN_FLASH_LOAN_WSTETH=100000000000000000
MAX_FLASH_LOAN_WSTETH=1000000000000000000

# CBBTC (8 decimals)
# MIN: 1000000 = 0.01 CBBTC (~$600) | MAX: 10000000 = 0.1 CBBTC (~$6,000)
MIN_FLASH_LOAN_CBBTC=1000000
MAX_FLASH_LOAN_CBBTC=10000000

# AERO (18 decimals)
MIN_FLASH_LOAN_AERO=100000000000000000
MAX_FLASH_LOAN_AERO=1000000000000000000

# -----------------------------------------------------------------------------
# Foundry Scripts — SetupRoles.s.sol (uses ADMIN key)
# -----------------------------------------------------------------------------
# Run AFTER Deploy.s.sol to separate OPERATOR/PAUSER roles.
# This script is called with the ADMIN key (same PRIVATE_KEY above).
# ARBITRAGE_CONTRACT_ADDRESS=0x...  (from deploy output)
# OPERATOR_ADDRESS=0x...            (bot hot wallet — receives OPERATOR_ROLE only)
# PAUSER_ADDRESS=0x...              (emergency wallet — receives PAUSER_ROLE only)

# -----------------------------------------------------------------------------
# Foundry Tests
# -----------------------------------------------------------------------------
# Base mainnet RPC URL for fork tests (optional, defaults to public RPC)
BASE_RPC_URL=https://mainnet.base.org

# -----------------------------------------------------------------------------
# Bot Runtime (used by TypeScript bot, not Foundry)
# -----------------------------------------------------------------------------
# IMPORTANT: The bot uses the OPERATOR key, NOT the admin key!
# If the bot server is hacked, the attacker can only execute arbitrage.
# The admin can instantly revoke the operator role to kill the bot.

# RPC endpoint for Base mainnet
# BASE_RPC_URL=https://mainnet.base.org

# Deployed FlashLoanArbitrage contract address
# ARBITRAGE_CONTRACT_ADDRESS=0x...

# Operator PRIVATE_KEY (the bot hot wallet — NOT the admin wallet!)
# This wallet should have ONLY OPERATOR_ROLE, not ADMIN_ROLE
# PRIVATE_KEY=0x_YOUR_OPERATOR_PRIVATE_KEY_HERE

# Minimum profit threshold in token units (e.g. 1000000 = 1 USDC)
# MIN_PROFIT_THRESHOLD=1000000

# Enable live execution (false = dry-run only, true = real transactions)
# LIVE_EXECUTION=false

# Scan interval in milliseconds
# SCAN_INTERVAL_MS=12000

# Moonwell OEV API key (if using OEV path)
# MOONWELL_OEV_API_KEY=

# Graph API key (for position scanning)
# GRAPH_API_KEY=
