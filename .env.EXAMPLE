# --- Deployment ---
# Private key of the wallet that will deploy + own the FlashLoanArbitrage
# contract. NEVER commit your real .env file. Use a burner/dedicated key.
PRIVATE_KEY=

# --- RPC endpoints ---
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Contract verification ---
BASESCAN_API_KEY=

# --- Off-chain bot (bot/) ---
# Address of the deployed FlashLoanArbitrage contract (fill in after deploying).
ARBITRAGE_CONTRACT_ADDRESS=

# Minimum profit (in the borrowed asset's smallest unit) required before the
# bot will fire a transaction. Protects against paying gas for a route whose
# edge has already disappeared.
MIN_PROFIT_WEI=1000000000000000
FOUNDRY_DISABLE_NIGHTLY_WARNING

LIVE_EXECUTION=false
ML_ENABLED=true
ML_MIN_CONFIDENCE=0.7
ML_MIN_OVERALL_SCORE=0.6
ML_USE_TIMING=true
ML_USE_POSITION_SIZING=true